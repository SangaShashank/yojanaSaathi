# ==================================================
# Yojana Saathi - Environment Configuration Template
# ==================================================
# Copy this file to '.env' and fill in your real credentials.
# NEVER commit your actual '.env' file to source control.

# Google Gemini API Key (Required for Phase 2/3 LLM reasoning and extraction)
GEMINI_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemma-4-31b-it

# GroqCloud Whisper API Key (Required for Phase 8 Voice STT)
GROQ_API_KEY=your_groq_api_key_here
# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yojana_saathi
POSTGRES_USER=yojana_saathi
POSTGRES_PASSWORD=123ali123$
DATABASE_URL=postgresql+psycopg://yojana_saathi:CHANGE_ME@localhost:5432/yojana_saathi

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO