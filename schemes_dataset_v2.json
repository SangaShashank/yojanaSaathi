[
  {
    "scheme_id": "pm_kisan_001",
    "schema_version": "2.0",
    "niche": "farmers",
    "title_en": "Pradhan Mantri Kisan Samman Nidhi (PM-KISAN)",
    "title_hi": "प्रधानमंत्री किसान सम्मान निधि",
    "ministry": "Ministry of Agriculture & Farmers Welfare",
    "target_audience": [
      "farmer"
    ],
    "state_restriction": null,
    "benefit": {
      "summary_en": "Rs 6,000 per year, paid in 3 installments of Rs 2,000 every 4 months, direct bank transfer",
      "breakdown": [
        {
          "condition": "default",
          "amount_inr": 6000,
          "unit": "per_year",
          "installments": 3,
          "installment_amount_inr": 2000,
          "frequency": "every_4_months"
        }
      ],
      "disputed": false
    },
    "eligibility": {
      "critical_fields": [
        "age",
        "land_ownership",
        "land_record_date",
        "occupation",
        "farmer_id_status"
      ],
      "conditions": [
        {
          "field": "age",
          "op": "gte",
          "value": 18
        },
        {
          "field": "land_ownership",
          "op": "eq",
          "value": true,
          "scope": "farmer_family (self, spouse, minor children)"
        },
        {
          "field": "land_record_date",
          "op": "lte",
          "value": "2019-02-01",
          "note": "Land acquired by purchase after Feb 1, 2019 is NOT eligible; succession/inheritance transfers remain allowed. Confirmed still enforced as of 2026 sources."
        },
        {
          "field": "occupation",
          "op": "not_in",
          "value": [
            "institutional_landholder",
            "serving_or_retired_govt_employee_above_pension_threshold",
            "income_tax_payer",
            "professional_doctor_engineer_lawyer_ca_practicing"
          ]
        },
        {
          "field": "farmer_id_status",
          "op": "eq",
          "value": "registered",
          "note": "Farmer ID (separate from Aadhaar) mandatory from 2026 onward to continue receiving installments."
        }
      ],
      "notes": "Eligibility is per 'farmer family' (self, spouse, minor children) owning cultivable land per state land records."
    },
    "relationships": {
      "stackable_with": [
        "ts_rythu_bharosa_001"
      ],
      "mutually_exclusive_with": [],
      "notes": "Confirmed stackable with Rythu Bharosa (Telangana state scheme) — an eligible farmer can receive both; the agent should present both, not as alternatives."
    },
    "required_documents": [
      {
        "doc_id": "aadhaar",
        "name_en": "Aadhaar Card",
        "name_hi": "आधार कार्ड",
        "is_mandatory": true,
        "source_office": "UIDAI / CSC"
      },
      {
        "doc_id": "land_record",
        "name_en": "Land Ownership Record (Khatauni / RoR)",
        "name_hi": "भूलेख / खतौनी नकल",
        "is_mandatory": true,
        "source_office": "Tehsil / Revenue Dept (Bhulekh portal)"
      },
      {
        "doc_id": "bank_passbook",
        "name_en": "Aadhaar-seeded Bank Passbook",
        "name_hi": "आधार लिंक बैंक पासबुक",
        "is_mandatory": true,
        "source_office": "Bank Branch"
      },
      {
        "doc_id": "farmer_id",
        "name_en": "Farmer ID (mandatory from 2026 onward)",
        "is_mandatory": true,
        "source_office": "State Agriculture Department portal"
      }
    ],
    "official_portal_url": "https://pmkisan.gov.in",
    "last_verified": "2026-09-12",
    "disputed_fields": [],
    "verify_before_demo": []
  },
  {
