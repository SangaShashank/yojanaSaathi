        "max_inr": 200,
        "unit": "per_month",
        "note": "Confirmed 2026: Rs 55/month at entry age 18 up to Rs 200/month at entry age 40, scaled by entry age; government matches contribution 1:1; unchanged for 2026. LIC is the pension fund manager."
      },
      "disputed": false
    },
