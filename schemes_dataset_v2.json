  {
    "scheme_id": "pmfby_001",
    "schema_version": "2.0",
    "niche": "farmers",
    "title_en": "Pradhan Mantri Fasal Bima Yojana (PMFBY)",
    "title_hi": "प्रधानमंत्री फसल बीमा योजना",
    "ministry": "Ministry of Agriculture & Farmers Welfare",
    "target_audience": [
      "farmer"
    ],
    "state_restriction": null,
    "benefit": {
      "summary_en": "Crop insurance covering yield loss from natural calamities, pests, disease; farmer pays a small subsidized premium",
      "breakdown": [
        {
          "item": "premium_rate_pct",
          "season": "kharif",
          "value": 2
        },
        {
          "item": "premium_rate_pct",
          "season": "rabi",
          "value": 1.5
        },
        {
          "item": "premium_rate_pct",
          "crop_type": "commercial_or_horticultural",
          "value": 5
        }
      ],
      "disputed": false
    },
    "eligibility": {
      "critical_fields": [
        "state",
        "cultivates_notified_crop",
        "crop_season",
        "land_or_tenancy_status"
      ],
      "conditions": [
        {
          "field": "cultivates_notified_crop",
          "op": "eq",
          "value": true,
          "note": "Must be a notified crop in a notified area for that season"
        },
        {
          "field": "land_or_tenancy_status",
          "op": "in",
          "value": [
            "landowner",
            "tenant_farmer",
            "sharecropper"
          ]
        },
        {
          "field": "enrollment_type",
          "op": "eq",
          "value": "voluntary",
          "note": "Voluntary enrollment since Kharif 2020"
        },
        {
          "field": "state",
          "op": "eq",
          "value": "Telangana",
          "applies_only_if": "user_state == Telangana",
          "note": "TELANGANA STATUS: historically opted out of PMFBY, but a July 2026 source lists Telangana among currently-participating states for Kharif 2026, and PIB confirms PMFBY active in 25 states/UTs nationally as of Kharif 2026 — appears to have rejoined. This has flipped before and could flip again."
        }
      ],
      "notes": "Covers both landowning and tenant/sharecropper farmers."
    },
    "relationships": {
      "stackable_with": [],
      "mutually_exclusive_with": [],
      "notes": ""
    },
    "required_documents": [
      {
        "doc_id": "aadhaar",
        "name_en": "Aadhaar Card",
        "is_mandatory": true,
        "source_office": "UIDAI / CSC"
      },
      {
        "doc_id": "land_record_or_tenancy_proof",
        "name_en": "Land Record or Tenancy/Cultivation Agreement",
        "is_mandatory": true,
        "source_office": "Tehsil / Panchayat"
      },
      {
        "doc_id": "bank_passbook",
        "name_en": "Bank Passbook",
        "is_mandatory": true,
        "source_office": "Bank Branch"
      },
      {
        "doc_id": "sowing_declaration",
        "name_en": "Sowing Certificate/Declaration",
        "is_mandatory": true,
        "source_office": "Village Patwari / Agriculture Officer"
      }
    ],
    "official_portal_url": "https://pmfby.gov.in",
    "last_verified": "2026-09-12",
    "disputed_fields": [
      "telangana_participation_status"
    ],
    "verify_before_demo": [
      "final same-week confirmation that Telangana's PMFBY participation hasn't changed again"
    ]
  },
