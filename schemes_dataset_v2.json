  {
    "scheme_id": "pmmvy_001",
    "schema_version": "2.0",
    "niche": "women",
    "title_en": "Pradhan Mantri Matru Vandana Yojana (PMMVY)",
    "title_hi": "प्रधानमंत्री मातृ वंदना योजना",
    "ministry": "Ministry of Women & Child Development",
    "target_audience": [
      "woman",
      "pregnant_or_lactating"
    ],
    "state_restriction": null,
    "benefit": {
      "summary_en": "Cash support for a first living child, plus a one-time top-up if the second child is a girl",
      "breakdown": [
        {
          "condition": "first_living_child",
          "amount_inr": 5000,
          "installments": [
            {
              "stage": "after_antenatal_checkup",
              "amount_inr": 3000
            },
            {
              "stage": "after_birth_registration_and_first_immunization_cycle",
              "amount_inr": 2000
            }
          ]
        },
        {
          "condition": "second_child_is_girl",
          "amount_inr": 6000,
          "unit": "one_time"
        }
      ],
      "disputed": true,
      "disputed_note": "Installment split structure has changed before and should be re-verified close to demo."
    },
    "eligibility": {
      "critical_fields": [
        "age",
        "pregnancy_or_lactation_status",
        "lmp_date",
        "occupation",
        "income_category"
      ],
      "conditions": [
        {
          "field": "age",
          "op": "gte",
          "value": 19
        },
        {
          "field": "pregnancy_or_lactation_status",
          "op": "eq",
          "value": true
        },
        {
          "field": "registration_days_after_lmp",
          "op": "lte",
          "value": 150,
          "note": "Registration must happen within 150 days of last menstrual period to get the full installment sequence"
        },
        {
          "field": "occupation",
          "op": "not_in",
          "value": [
            "central_or_state_govt_employee",
            "already_receiving_similar_statutory_benefit"
          ],
          "exception": "anganwadi_or_asha_worker",
          "note": "Anganwadi/ASHA workers remain eligible despite quasi-government role"
        },
        {
          "field": "income_qualifying_condition",
          "op": "any_of",
          "value": [
            {
              "category": "sc_st"
            },
            {
              "category": "bpl_ration_card"
            },
            {
              "category": "mgnrega_or_eshram_or_pmjay_cardholder"
            },
            {
              "field": "annual_family_income_inr",
              "op": "lte",
              "value": 800000
            }
          ],
          "disputed": true,
          "note": "GENUINELY CONFLICTING SOURCES as of 2026: some describe eligibility via meeting ANY ONE of several qualifying conditions (not a strict universal income ceiling); others state PMMVY applies 'irrespective of family income.' Present as 'covers SC/ST, BPL, or lower-income families meeting one of several qualifying conditions' — consistent across all sources checked. Do not state a single hard income number as fact."
        }
      ],
      "notes": ""
    },
    "relationships": {
      "stackable_with": [],
      "mutually_exclusive_with": [],
      "notes": ""
    },
    "required_documents": [
      {
        "doc_id": "aadhaar",
        "name_en": "Aadhaar Card",
        "is_mandatory": true,
        "source_office": "UIDAI / CSC"
      },
      {
        "doc_id": "mcp_card",
        "name_en": "Mother and Child Protection (MCP) Card",
        "is_mandatory": true,
        "source_office": "Anganwadi Centre / Health Facility"
      },
      {
        "doc_id": "bank_passbook",
        "name_en": "Bank/Post Office Passbook",
        "is_mandatory": true,
        "source_office": "Bank Branch / Post Office"
      },
      {
        "doc_id": "consent_form",
        "name_en": "Signed Consent & Registration Form",
        "is_mandatory": true,
        "source_office": "Anganwadi Centre"
      }
    ],
