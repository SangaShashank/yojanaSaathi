      ],
      "notes": ""
    },
    "relationships": {
      "stackable_with": [],
      "mutually_exclusive_with": [],
      "notes": ""
    },
    "required_documents": [
      {
        "doc_id": "aadhaar",
        "name_en": "Aadhaar Card",
        "is_mandatory": true,
        "source_office": "UIDAI / CSC"
      },
      {
        "doc_id": "land_record",
        "name_en": "Land Ownership Record",
        "is_mandatory": true,
        "source_office": "Tehsil / Revenue Dept"
      },
      {
